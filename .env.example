# Set real values in Netlify (Site configuration -> Environment variables). Never commit them.
# Signing secret entered when creating the webhook in Lemon Squeezy.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Full Firebase service-account JSON for project gasa-beach, as one line.
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated Lemon Squeezy variant id(s) of the Side or Serve subscription.
LS_VARIANT_IDS=
