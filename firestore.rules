rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Player profiles ──────────────────────────────────────────────────────
    // Each user owns their own doc and all subcollections.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Partner relationship records
      match /partners/{partnerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Shared-match cross-references written into a partner's subcollection
      match /matches/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Shared-set cross-references written into a partner's subcollection
      match /sets/{setId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Top-level matches collection ─────────────────────────────────────────
    // Any authenticated user can read (needed for shared-match lookup).
    // Create/update/delete requires the caller to be the document owner.
    // Separate create rule uses request.resource.data (doc doesn't exist yet).
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── Top-level sets collection ────────────────────────────────────────────
    // All queries use where('userId', '==', currentUser.uid).
    // Create rule must reference request.resource.data (no existing doc yet).
    // Read/update/delete use resource.data (existing doc).
    match /sets/{setId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

  }
}
