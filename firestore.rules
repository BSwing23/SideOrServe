rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // — Player profiles ————————————————————
    // Each user owns their own doc and all subcollections.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Paired partner can mirror team-level RP stats onto this account too —
      // scoped to ONLY the rpStats field so a partner can never touch
      // name/email/role/anything else on this profile.
      allow update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rpStats'])
        && get(/databases/$(database)/documents/players/$(request.auth.uid)/partners/$(uid)).data.status == 'paired';

      // Partner relationship records
      match /partners/{partnerId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == partnerId);
      }

      // Shared-match cross-references written into a partner's subcollection
      match /matches/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Shared-set cross-references written into a partner's subcollection
      match /sets/{setId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /venueStats/{venueId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // — Top-level matches collection ————————————————————
    match /matches/{matchId} {
      // Owner; a partner the match was shared with (they hold a reference doc keyed
      // by this matchId); or a coach in the same program.
      allow read: if request.auth != null && (
          request.auth.uid == resource.data.userId
          || exists(/databases/$(database)/documents/players/$(request.auth.uid)/matches/$(matchId))
          || (resource.data.programId != null
              && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'coach'
              && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.programId == resource.data.programId));
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
                      && request.auth.uid == resource.data.userId;
    }

    // — Top-level sets collection ————————————————————
    // A set's "owners" array may include a paired partner — either owner can
    // create/read/update/delete, so shared matches mirror into both accounts.
    match /sets/{setId} {
      allow create: if request.auth != null
                      && (request.auth.uid == request.resource.data.userId
                          || request.auth.uid in request.resource.data.owners);
      allow read, update, delete: if request.auth != null
                      && (request.auth.uid == resource.data.userId
                          || request.auth.uid in resource.data.owners);
    }

    // Subscription status (Lemon Squeezy): users read only their own record;
    // only the webhook (Admin SDK) can write it.
    match /subscribers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Admin-only team roster
    match /roster/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'brian.scott.swingle@gmail.com';
    }

  }
}
